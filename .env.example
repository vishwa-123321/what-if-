# GEMINI_API_KEY: Required for Gemini AI Story Engine calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (server-side database & auth sync)
# Add your Supabase project credentials in Settings -> Secrets to enable live Supabase persistence.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public client-side Supabase keys (safe to expose to browser for Supabase Auth)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
